  "dependencies": {
    "@pulumi/kubernetes": "^4.18.0",
    "@pulumi/pulumi": "^3.150.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.15.0",
    "eslint": "^9.39.0",
    "globals": "^16.0.0",
    "js-yaml": "^5.4.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.46.0",
