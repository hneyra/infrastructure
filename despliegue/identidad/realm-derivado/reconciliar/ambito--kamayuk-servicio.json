{
  "name": "kamayuk-servicio",
  "description": "El ambito de una identidad de servicio (ADR-0028 §2). Lleva `municipalidad_id` al token desde el atributo de la cuenta de servicio. Los clientes por municipalidad los crea `reconciliar-identidades.sh servicios` (ADR-0012).",
  "protocol": "openid-connect",
  "attributes": {
    "include.in.token.scope": "true",
    "display.on.consent.screen": "false"
  },
  "protocolMappers": [
    {
      "name": "municipalidad-id",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-usermodel-attribute-mapper",
      "consentRequired": false,
      "config": {
        "user.attribute": "municipalidad_id",
        "claim.name": "municipalidad_id",
        "jsonType.label": "long",
        "id.token.claim": "false",
        "access.token.claim": "true",
        "userinfo.token.claim": "false"
      }
    }
  ]
}
