# Copiar a `.env` y poner claves generadas, no estas.
#
#   cd despliegue && cp .env.ejemplo .env
#   sed -i "s/CAMBIAR_.*/$(openssl rand -hex 24)/" .env   # una por linea, no todas iguales
#
# `.env` esta en .gitignore. Si alguna vez aparece en un diff, la clave que lleve
# deja de ser una clave: hay que rotarla, no borrarla del commit.

# Superusuario del motor. Existe solo dentro del contenedor de la base: ni la
# aplicacion ni el migrador lo usan nunca, y el migrador se niega a trabajar con
# un rol que sea superusuario o tenga BYPASSRLS.
KAMAYUK_CLAVE_SUPERUSUARIO=CAMBIAR_superusuario

# El unico rol con DDL. Vive en el contenedor de migracion, que corre y termina.
KAMAYUK_CLAVE_OWNER=CAMBIAR_owner

# El rol de la aplicacion: sin DDL, sin BYPASSRLS, sin DELETE y propietario de
# nada. Es el que lleva el proceso que esta expuesto en HTTP.
KAMAYUK_CLAVE_APP=CAMBIAR_app

# rol_carga_parametros (issue #387): la unica credencial que puede escribir
# parametro_tributario y las tablas de valuacion nacionales. Solo la usan los
# guiones de infra/carga-de-datos/ (publicar-parametros.sh, publicar-cuadros.sh);
# nunca la aplicacion.
KAMAYUK_CLAVE_CARGA=CAMBIAR_carga

# Administracion de Keycloak. Existe para crear usuarios y mirar el realm; no la
# usa ningun servicio para funcionar.
KAMAYUK_CLAVE_KEYCLOAK=CAMBIAR_keycloak

# La clave de los usuarios de verificacion que crea CI. En una instalacion de
# verdad no hace falta: los usuarios se crean con identidad/crear-usuario.sh.
KAMAYUK_CLAVE_VERIFICACION=CAMBIAR_verificacion

# El emisor, tal como lo ve el NAVEGADOR. Es lo que Keycloak pone en el `iss` de
# cada token y lo que el backend compara. En una instalacion real es el nombre
# publico con https, y entonces hay que cambiarlo aqui y reconstruir la imagen de
# la interfaz, porque Vite lo resuelve al compilar.
KAMAYUK_OIDC_EMISOR=http://localhost:8180

# ---------------------------------------------------------------------------
# La municipalidad que se implanta. Sin esto no hay nada dentro del sistema: sin
# fila en `municipalidad` no hay municipalidad_id que poner en ningun token.
KAMAYUK_UBIGEO=200101
KAMAYUK_MUNICIPALIDAD="Municipalidad Provincial de Sullana"
KAMAYUK_TIPO_DE_MUNICIPALIDAD=PROVINCIAL

# ¿Es una instalacion de demostracion? Si lo es, TODO documento que emita sale
# marcado —en PDF, hoja de calculo y texto enriquecido— y no se puede confundir
# con uno real (#122).
#
# Por omision `true`, y conviene entender por que: mientras D-02a siga abierta,
# cualquier importe que el sistema calcule sale de tramos, alicuotas y UIT que
# nadie ha firmado. Un papel con una cifra plausible y sin marca es un papel que
# alguien puede intentar cobrar. Una instalacion de verdad tiene que declararse
# como tal; olvidarse solo produce papeles marcados de mas.
#
# Solo se aplica al ALTA de la municipalidad. Ponerlo en `false` y relanzar el
# despliegue NO le quita la marca a una instalacion ya implantada: eso es un
# UPDATE deliberado sobre `municipalidad.es_demostracion`, como kamayuk_owner, y
# deja rastro de quien lo hizo.
KAMAYUK_ES_DEMOSTRACION=true

# El primer administrador. La cuenta TIENE que ser la misma que el usuario de
# Keycloak: es lo unico que une la fila de la base con la identidad del token, y
# si no coinciden la persona entra y el sistema no sabe quien es.
#
# Estas dos NO se escriben a mano: salen del archivo versionado de la
# municipalidad (ADR-0012), del usuario marcado `administrador: true`:
#
#   ./identidad/datos-de-implantacion.sh 200101 >> .env
#
# Y los usuarios se dan de alta declarativamente, sin clave, con:
#
#   ./identidad/reconciliar-identidades.sh
#
# El sistema no guarda contrasenas (ADR-0005): la clave la fija el usuario en su
# primer acceso, con el enlace que Keycloak le manda por correo (buzon `correo`).
KAMAYUK_ADMINISTRADOR=jperez
KAMAYUK_NOMBRE_DEL_ADMINISTRADOR="Jorge Perez"

# ---------------------------------------------------------------------------
# Puertos publicados. La aplicacion, Keycloak, la interfaz y el buzon de correo.
KAMAYUK_PUERTO=8080
KAMAYUK_PUERTO_IDENTIDAD=8180
KAMAYUK_PUERTO_INTERFAZ=8081
KAMAYUK_PUERTO_CORREO=8025

# ---------------------------------------------------------------------------
# A QUIEN se le avisa cuando algo de operacion necesita una persona, y DONDE
# (ADR-0026 §4, C-7 §4). `caja` NO ARRANCA sin las dos —ni su perfil web ni su
# implantacion—, y eso es deliberado: una alerta sin destinatario acaba en un
# panel que nadie mira. En el cluster salen del stack
# (`kamayuk:responsableDeOperacion` y `kamayuk:canalDeOperacion`); aqui, de aqui.
KAMAYUK_RESPONSABLE_DE_OPERACION="Equipo de operacion (ensayo)"
KAMAYUK_CANAL_DE_OPERACION=operaciones@example.pe

# ---------------------------------------------------------------------------
# Puertos que publica el compose de la PLATAFORMA. Los cuatro sistemas no
# publican ninguno: se entra por el ingreso, bajo el prefijo de cada uno
# (ADR-0030 §2), que es la misma ruta que en el cluster.
KAMAYUK_PUERTO_BASE=5432
KAMAYUK_PUERTO_INGRESO=8080
